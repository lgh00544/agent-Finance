# ============================================================
# 环境配置模板 - 复制为 .env 后填写真实值
#   Windows 本机:  cp .env.example .env
#   Linux/macOS:  cp .env.example .env
# 严禁将真实密钥提交到版本库
# ============================================================

# ---------- 运行模式 ----------
# dev  = 本机直跑；prod = Docker 部署标识。存储形态由下面三个后端开关决定
APP_ENV=dev

# ---------- 存储后端（默认全本地文件，零外部依赖；迁移系统直接复制 data/ 目录）----------
# 数据库：sqlite=单文件 data/dev.db（默认）/ mysql=外部 MySQL 服务
DB_BACKEND=sqlite
# 缓存：memory=进程内存（默认，重启清空）/ redis=外部 Redis 服务
CACHE_BACKEND=memory
# 向量库：local=本地文件模式 Qdrant，数据存 data/qdrant_storage（默认）/ server=外部 Qdrant 服务
QDRANT_MODE=local

# ---------- MySQL（DB_BACKEND=mysql 时生效）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=stock

# ---------- Redis（CACHE_BACKEND=redis 时生效）----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---------- Qdrant 服务（QDRANT_MODE=server 时生效）----------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ---------- DeepSeek LLM（双模型分场景路由，OpenAI 兼容端点）----------
# 必填。https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 轻量默认模型：高频轻量场景（Discover 初筛 / Monitor 盘中巡检 / 告警生成等），速度与成本优先
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
# 深度推理模型：复杂研判场景（市况评分 / 最终候选确认 / 五维打分 / 建仓方案 / 卖出决策 / 复盘与重思考）
DEEPSEEK_REASONING_MODEL=deepseek-chat
# flash 输出上限：轻量场景足够，防止大 token 浪费（flash 不支持内部思考，无需预留思考预算）
DEEPSEEK_FLASH_MAX_TOKENS=8192
# 深度推理模型输出上限：留足空间防大表输出 JSON 截断（deepseek-chat 路由推理模型，
# 内部思考也计入输出，默认会耗尽预算导致空响应；配合 REASONING_EFFORT=low 使用）
LLM_MAX_TOKENS=32768
# 推理强度（仅深度推理模型生效，flash 不传推理参数）
REASONING_EFFORT=low

# ---------- Embedding 向量化 ----------
# siliconflow = 硅基流动 bge-m3 免费 API（默认，推荐）
# local       = 本地 sentence-transformers bge-small-zh（离线降级，需下载模型 ~100MB）
EMBEDDING_PROVIDER=siliconflow
# 硅基流动 API Key：https://siliconflow.cn 注册获取（bge-m3 免费额度）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# 本地降级模型名（EMBEDDING_PROVIDER=local 时生效）
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 飞书告警 ----------
# 可选。机器人 webhook 地址，留空则告警仅落库 alert_log 表不推送
FEISHU_WEBHOOK_URL=

# ---------- 资金与交易风格（用于 PositionAgent 建仓约束）----------
# 总资金（元），仅用于仓位比例计算参考（持仓列表「目标仓位%」= 当前市值 ÷ 总资金）
TOTAL_CAPITAL=100000
# 单只标的仓位上限（%），按 0-100 填写
MAX_SINGLE_POSITION_PCT=40
# 交易风格描述（会注入 PositionAgent prompt）
TRADE_STYLE=波段趋势交易，中线持有，分批建仓，严格执行止损
# 持仓列表「参考止损/参考止盈」默认风控比例（%）：持仓未手动设置且无关联建仓计划时，
# 按持仓成本计算展示用参考价（仅展示参考，不落库、不触发任何判断，可自行调整）
DEFAULT_STOP_LOSS_PCT=8
DEFAULT_TAKE_PROFIT_PCT=15

# ---------- Discover 刚性过滤（客观条件，非主观判断）----------
# 按当日成交额客观排序后送入 LLM 的股票数量
DISCOVER_TOP_N=300
# 最低成交额（元），流动性刚性过滤线
MIN_AMOUNT=100000000

# ---------- 市况评分档位（v2.0，可选）----------
# 市况评分（0-50）→ 候选池规模上限 的档位映射，JSON 数组，每档 [最低分, 最高分, 候选池上限, 档位名]。
# 留空使用默认四档：防御期5只(0-20)/过渡期10只(21-35)/温和期15只(36-45)/强势期20只(46-50)
MARKET_CAP_BANDS=[[0, 20, 5, "防御期"], [21, 35, 10, "过渡期"], [36, 45, 15, "温和期"], [46, 50, 20, "强势期"]]

# ---------- 调度 ----------
# 每日挖掘触发时间（Asia/Shanghai，工作日 16:10 默认）
DISCOVER_HOUR=16
DISCOVER_MINUTE=10
# 盘中监控间隔（分钟）
MONITOR_INTERVAL_MINUTES=5
# MonitorAgent LLM 调用节流（分钟）：同一标的两次 LLM 研判的最小间隔
MONITOR_LLM_CACHE_MINUTES=3

# ---------- 数据源稳定性（请求加固/断路器/限流，均有合理默认值）----------
# 东财/新浪实时接口易被反爬限流：浏览器请求头 + 连接/读取超时拆分 + 失败后间隔重试 +
# 连续失败进入临时降级（只走备用源，冷却到期静默探测自动切回）。以下一般无需修改。
# 连接超时（秒，TCP 握手）
DATASOURCE_CONNECT_TIMEOUT=5
# 读取超时（秒）
DATASOURCE_READ_TIMEOUT=15
# 实时热点路径失败后重试次数（间隔 1-2s，勿设 0 立即重试触发限流）
DATASOURCE_RETRY_TIMES=1
# 重试间隔（秒）
DATASOURCE_RETRY_DELAY=1.5
# 连续失败次数阈值，达到后进入临时降级（10 分钟内只走备用源）
DATASOURCE_BREAKER_THRESHOLD=3
# 临时降级持续时间（秒），到期下次调用静默探测主源，成功自动切回
DATASOURCE_BREAKER_COOLDOWN=600
# 同类实时请求最小间隔（秒），高频场景自动补齐
DATASOURCE_MIN_REQUEST_INTERVAL=0.5

# ---------- OCR 持仓截图识别（可选）----------
# true=启用本地 PaddleOCR 识别持仓截图（需已安装 backend/requirements.txt 中 OCR 依赖）；
# false=关闭（手动录入不受影响）。建议先试跑一张再启用
OCR_ENABLE=false
# 推理设备：cpu（默认）/ gpu（需 paddlepaddle-gpu + CUDA）
OCR_DEVICE=cpu
# 识别模型档位：light=轻量模型（默认，PP-OCRv4 mobile，体积约 20-50MB，省空间）/ full=完整模型（精度略高，体积更大）
OCR_MODEL_LEVEL=light

# ---------- 日志（自动轮转，防无限增长）----------
LOG_LEVEL=INFO
# 单个日志文件上限（MB），超过自动轮转
LOG_MAX_BYTES_MB=10
# 轮转保留份数（单文件×份数≈日志总占用上限）
LOG_BACKUP_COUNT=5

# ---------- MiniMax M3 多模态能力（持仓截图识别云端引擎，按需开启）----------
# MiniMax M3 仅承担持仓截图 OCR 等视觉专项任务（预留 K 线图/财报截图等扩展场景），
# 不参与五 Agent 选股/建仓/监控等核心业务研判（主模型仍为 DeepSeek）。
# 关闭时系统行为与原版本完全一致：不加载任何依赖、不发起任何请求。
# 多模态能力总开关（开启后 OCR 自动优先云端识别，识别准确率更高）
MINIMAX_ENABLE=false
# MiniMax API 密钥（从 https://platform.minimaxi.com 获取；仅环境变量管理，严禁硬编码/提交版本库）
MINIMAX_API_KEY=
# 接口基础地址（官方 OpenAI 兼容端点；国内 api.minimax.chat/v1 / 国际 api.minimaxi.com/v1）
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# 模型 ID（官方文档 ID 含连字符，勿去掉）
MINIMAX_MODEL=MiniMax-M3
# true=默认优先 MiniMax 云端识别持仓截图（失败自动回退本地 PaddleOCR，不阻塞录入，
# 同一张截图 30 分钟内不重复消耗 API）；false=强制仅用本地 PaddleOCR（离线，无 API 消耗）
MINIMAX_OCR_ENABLE=true

# ---------- 麦蕊智数增强数据源（可选，默认关闭）----------
# 麦蕊（mairui.club）作为 akshare 的补充数据源：仅用于 v2.0 选股机制的高级资金面/股东面字段
# （资金结构/阶段主力动向/股东户数），基础行情仍优先走 akshare（东财→新浪双通道），减少配额消耗。
# 默认关闭时系统行为与之前完全一致；启用后高级字段优先麦蕊、失败自动回退 akshare，不报错中断。
MAIRUI_ENABLE=false
# 麦蕊证书密钥（仅此环境变量管理，更换证书只改这里，无需改动业务代码；示例留空，真实密钥填在 .env）
MAIRUI_LICENCE=
# 麦蕊接口基础地址
MAIRUI_BASE_URL=https://api.mairuiapi.com

# ---------- 龙虎榜数据源（游资维度数据链，可选；默认关闭）----------
# 龙虎榜流水落 lhb_original_flow 表：席位级（游资-席位映射）+ 股票级（东财/新浪多源校验）。
# 开启后调度每日 16:30（T+1）自动拉取前一日龙虎榜，也可手动跑
#   .venv/Scripts/python backend/scripts/fetch_dragon_tiger.py [YYYY-MM-DD]
DRAGON_TIGER_ENABLE=false
# 多源校验差值阈值（%）：同一(日期,标的,口径)至少 2 源且差值 < 阈值 才采信，否则标"数据置信度不足"仅参考
DRAGON_TIGER_VERIFY_THRESHOLD=10.0
# 第二龙虎榜数据源开关：auto=自动探测（当前同花顺需 JS hexin-v token 不可用、新浪每日明细无金额明细
# → 仅东财可用，系统如实标注"采信待第二源"，不伪造第二源数据 K227）；sina=新浪（仅上榜确认）；
# none=明确只用东财单源（置信度不足降级保留）
DRAGON_TIGER_SECOND_SOURCE=auto

# ---------- 存储空间维护（低频自动清理）----------
# 新闻/公告保留周期（天），超期自动清理；候选/评分/持仓/复盘等关键分析数据不清理
NEWS_RETENTION_DAYS=90
# 定时空间维护总开关（SQLite 真空收缩 + 超期数据清理 + 向量库超期索引清理）
DB_MAINTENANCE_ENABLED=true
# 每周执行日（0=周一 … 6=周日，默认周日凌晨 05:30，避开交易时段）
DB_MAINTENANCE_DAY_OF_WEEK=6
DB_MAINTENANCE_HOUR=5
DB_MAINTENANCE_MINUTE=30
# 本地文件模式 Qdrant 是否启用标量量化压缩（true=默认，减少向量库磁盘占用）
QDRANT_COMPRESSION=true
