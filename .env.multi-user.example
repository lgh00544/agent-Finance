# 多人化旁路开发环境；复制为 .env.multi-user 后由独立启动命令加载
APP_ENV=dev
MULTI_USER_ENABLED=false
SERVER_PORT=8100
SYNC_ON_START=false

# 独立 SQLite 文件，不触碰主工作区 data/dev.db 或生产 TiDB
DB_BACKEND=sqlite
SQLITE_PATH=D:/self-multi-user/data/multi-user.db

# 独立 Redis namespace；启用 redis 时仍使用独立 DB
CACHE_BACKEND=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=15
REDIS_NAMESPACE=stock-agent:multi-user

# 独立本地 Qdrant 路径
QDRANT_MODE=local
QDRANT_LOCAL_PATH=D:/self-multi-user/data/qdrant_multi_user

# 默认开发账号仅用于初始化兼容旧数据，正式灰度前请改密
AUTH_DEFAULT_USERNAME=legacy
AUTH_DEFAULT_PASSWORD=change-me
AUTH_SESSION_TTL_HOURS=24
