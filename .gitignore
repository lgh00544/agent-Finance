# ===== 版本库忽略规则 =====
# 敏感配置（含 API Key，严禁提交）
.env

# 数据与运行产物
data/
*.db
*.sqlite3
logs/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage

# IDE
.idea/
.vscode/

# 容器
*.egg-info/

# 运行产物与缓存
_paddlex_check/
migration_*.zip

# 本地冷备快照（sync_manager.py backup 产物，按份滚动，不入库）
backup/

# 改动前备份目录（_bak_时间戳/）
_bak_*/

# 一次性连接探测脚本（可能含数据库密码明文，严禁提交）
_tidb_probe.py
_probe_*.py

# 改动前备份文件（*.bak / *.bak_时间戳 / .backup_日期目录）
*.bak
*.bak_*
.backup_*/

# 工具本地配置与临时文件
.codex/
.mcp.json.tmp

# 一次性临时脚本/日志（_tmp_* 一律不入库，仅留 workspace）
_tmp_*

# 个人提示词备份
CLAUDE_CODE_PROMPT*.md
CONFIDENCE_UPGRADE_PROMPT.md
SYNC_ON_START_PROMPT.md

# 本地个人配置
.claude/settings.local.json

# React web（Phase1 起）
web/node_modules/
web/dist/
web/.env.local

# ===== 补充忽略（2026-09-18 追加，不改动上方规则）=====
# 后端/前端 dev 运行日志（含轮转副本）
*-dev.stderr*.log
*-dev.stdout*.log
# 本地运行产物
storage/
.qdrant-initialized
# 批次证据目录（临时留痕，不入库）
.workbuddy/batch*_evidence_*/

# ===== 补充忽略（2026-09-22 追加，本地沙箱残留/日志/临时件）=====
# pytest 基目录与本地沙箱残留（带拒绝 ACL，无法读取，严禁入库）
.wb_h*/
.wb_pt/
.pytest_bt/
.pytest_tmp*/
pytest-of-*/
# 本地运行日志与临时探测输出
*.log
_sp*.txt
